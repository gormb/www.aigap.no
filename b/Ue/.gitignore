# Unreal Engine generated output
Build/
DerivedDataCache/
Intermediate/
Binaries/
Saved/*
!Saved/StagedBuilds/
Saved/StagedBuilds/*
!Saved/StagedBuilds/Wasm/
!Saved/StagedBuilds/Wasm/**
# Only the compressed module is shipped: GitHub rejects blobs over 100 MB and
# Pages cannot serve Git LFS, so the uncompressed module(s) must stay out.
/Saved/StagedBuilds/Wasm/LddMin/Binaries/Wasm/*.wasm

# The deployed LddMin pack needs its game loader and compressed module.
!LddMin_Pack/Wasm/LddMin/Binaries/
LddMin_Pack/Wasm/LddMin/Binaries/*
!LddMin_Pack/Wasm/LddMin/Binaries/Wasm/
LddMin_Pack/Wasm/LddMin/Binaries/Wasm/*
!LddMin_Pack/Wasm/LddMin/Binaries/Wasm/LddMin.js
!LddMin_Pack/Wasm/LddMin/Binaries/Wasm/LddMin.js.br
!LddMin_Pack/Wasm/LddMin/Binaries/Wasm/LddMin.wasm.br
!LddMin_Pack/Wasm/LddMin/Binaries/Wasm/LddMin-Wasm-Shipping.js
!LddMin_Pack/Wasm/LddMin/Binaries/Wasm/LddMin-Wasm-Shipping.js.br
!LddMin_Pack/Wasm/LddMin/Binaries/Wasm/LddMin-Wasm-Shipping.wasm.br

